# Copy to .env.local and fill in. Everything else lives in src/config.ts.

# Google Analytics 4 measurement ID, for example G-ABC123XYZ. Leave empty to disable GA.
VITE_GA_ID=

# Optional form backend (for example a Formspree endpoint). Leave empty and the
# tour request form opens WhatsApp with the request pre-filled instead.
VITE_FORM_ENDPOINT=

# Public site origin, no trailing slash. Used for canonical, hreflang and the sitemap.
VITE_SITE_URL=https://omanwithissam.com
